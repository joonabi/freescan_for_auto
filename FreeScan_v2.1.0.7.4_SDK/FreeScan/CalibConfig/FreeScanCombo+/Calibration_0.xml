			</positionInfo>
			<!-- 图片类型/命名相关 -->
			<captureInfo>
				<frames count="1">
					<!-- type: 0相机 3左倾 4右倾 5平行线 -->
					<frame0 type="5" grade="7">
						<cameras count="2" />

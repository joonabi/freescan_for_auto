<?xml version="1.0" encoding="utf-8"?>
<calibration>
	<!-- 标定类型 -->
	<type>0</type>
	<!-- 是否存图 -->
	<saveCalibImages>1</saveCalibImages>
	<!-- 是否读图 -->
	<readImages>0</readImages>
	<!-- 存图路径 -->
	<savePath>./res/FreeScanCombo+</savePath>
	<!-- 位姿计算算法接口 每个设备及标定板不一样需要配置 -->
	<poseAlgMethod>trackMarker</poseAlgMethod>
	<!-- 相机内外参计算 -->
	<cameraInExAlgMethod>runSn3DUEPExtrinsicCalibration</cameraInExAlgMethod>
	<!-- 光平面标定计算 -->
	<laserAlgMthod>runLaserRebuildTy</laserAlgMthod>
	<!-- 降采样计算 -->
	<downSampleCalc>true</downSampleCalc>
	<!-- 数据保存 -->
	<saveCalibData>true</saveCalibData>
	<!-- 写设备区间 -->
	<writeAreas>1</writeAreas>
	<commands>
		<command0 type="init">
			<!-- 设备指令相关 -->
			<DevCommand>
				<!-- 开关流 -->
				<stream>true</stream>
				<!-- 触发周期 ms -->
				<triggerPeriod>20</triggerPeriod>
				<gainExp>
				<!-- 117 = 150 / 1.28 GSY设备新激光器暂时这样配置 -->
					<GE1 gain="117" exp="1000" />
					<GE2 gain="117" exp="1000" />
				</gainExp>
				<led>0</led>
				<project></project>
				<!-- 激光配置 -->
				<laser>
					<!-- 激光线亮度 -->
					<LAS1 cross="true" grade="13" luminance="99" />
					<LAS2 cross="false" grade="1" luminance="40" />
					<LAS2 cross="false" grade="7" luminance="40" />
					<!-- 激光线投射模式 -->
					<laserNum>0</laserNum>
				</laser>
				<turnTable>
				</turnTable>
			</DevCommand>
			<!-- 界面指令 -->
			<UICommand>
				<!-- 当前标定第几组 -->
				<setGroupIndex param="0" />
				<!-- 大圆中心偏移 -->
				<setOffset offset="-175" />
				<!-- 标定板旋转 -->
				<rotation angle="0" />
			</UICommand>
			<!-- 算法指令 -->
			<AlgCommand>
			</AlgCommand>
		</command0>
		<command1 type="finish">
			<!-- 设备指令相关 -->
			<DevCommand>
				<!-- 开关流 -->
				<stream>false</stream>
				<laser>
					<laserNum>0</laserNum>
				</laser>
				<led>0</led>
			</DevCommand>
			<!-- 界面指令 -->
			<UICommand>
			</UICommand>
			<!-- 算法指令 -->
			<AlgCommand>
			</AlgCommand>
		</command1>
	</commands>
	<positionInfo>
		<!-- 设备旋转角度 -->
		<angle x="0" y="0" z="180" thresX="10" thresY="10" thresZ="10" />
		<!-- 设备中心投射到标定板位置 -->
		<pt x="0" y="0" z="0" thresDim="40" thresHeight="10" offsetX="0" offsetY="0" />
	</positionInfo>
	<!-- 图片类型/命名相关 -->
	<captureInfo>
		<cameras count="2">
			<camera0>
				<!-- 是否旋转 -->
				<rotation transpose="0" flip="1" width="1280" height="1024" />
			</camera0>
			<camera1>
				<!-- 是否旋转 -->
				<rotation transpose="0" flip="1" width="1280" height="1024" />
			</camera1>
		</cameras>
		<frames count="1">
			<!-- type: 0相机 3左倾 4右倾 5平行线 -->
			<frame0 type="0">
				<pictures>
					<!-- X_X_X_X_groupIndex_stepIndex -->
					<picture0 name="Left_Camera_%1_%2" />
					<picture1 name="Right_Camera_%1_%2" />
				</pictures>
			</frame0>
		</frames>
	</captureInfo>
	<groups count="6">
		<!-- 平行线 -->
		<group0  name="" count="9" distanceMid="170" distanceMax="230">
			<commands>

<?xml version="1.0" encoding="utf-8"?>
<calibration>
	<!-- 标定类型 -->
	<type>1</type>
	<!-- 是否存图 -->
	<saveCalibImages>1</saveCalibImages>
	<!-- 是否读图 -->
	<readImages>0</readImages>
	<!-- 存图路径 -->
	<savePath>./res/FreeScanUEPro</savePath>
	<!-- 位姿计算算法接口 每个设备及标定板不一样需要配置 -->
	<poseAlgMethod>runSn3DComputeFSRtPNP</poseAlgMethod>
	<!-- 相机内外参计算 -->
	<cameraInExAlgMethod>runSn3DFS4DoubleCameraCalibration</cameraInExAlgMethod>
	<!-- 降采样计算 -->
	<downSampleCalc>true</downSampleCalc>
	<!-- 切换标定模式-->
	<changeCalibType>2</changeCalibType> 
	<!-- 数据保存 -->
	<saveCalibData>true</saveCalibData>
	<!-- 写设备区间 
	<writeAreas>2</writeAreas> -->
	<commands>
		<command0 type="init">
			<!-- 设备指令相关 -->
			<DevCommand>
				<!-- 开关流 -->
				<stream>true</stream>
				<downSampling>false</downSampling>
				<!-- 触发周期 ms -->
				<triggerPeriod>20</triggerPeriod>
				<gainExp>
					<GE1 gain="200" exp="2000" />
					<GE2 gain="200" exp="2000" />
				</gainExp>
				<led>0</led>
				<!-- 激光配置 -->
				<laser>
					<!-- 激光线投射模式 -->
					<laserNum>0</laserNum>
				</laser>
				<project></project>
				<turnTable></turnTable>
			</DevCommand>
			<!-- 界面指令 -->
			<UICommand>
				<!-- 当前标定第几组 -->
				<setGroupIndex param="0" />
				<!-- 大圆中心偏移 -->
				<setOffset offset="0" />
				<!-- 标定板旋转 -->
				<rotation angle="0" />
			</UICommand>
			<!-- 算法指令 -->
			<AlgCommand>
			</AlgCommand>
		</command0>
		<command1 type="finish">
			<!-- 设备指令相关 -->
			<DevCommand>
				<!-- 开关流 -->
				<stream>false</stream>
				<led>0</led>
			</DevCommand>
			<!-- 界面指令 -->
			<UICommand>
			</UICommand>
			<!-- 算法指令 -->
			<AlgCommand>
			</AlgCommand>
		</command1>
	</commands>
	<positionInfo>
		<!-- 设备旋转角度 -->
		<angle x="0" y="0" z="180" thresX="10" thresY="10" thresZ="10" />
		<!-- 设备中心投射到标定板位置 -->
		<pt x="0" y="0" z="0" thresDim="40" thresHeight="10" offset="0" />
	</positionInfo>
	<!-- 图片类型/命名相关 -->
	<captureInfo>
		<cameras count="2">
			<camera0>
				<!-- 是否旋转 
				<rotation transpose="0" flip="1" width="1280" height="1024" />-->
				<!-- 是否裁剪 -->
				<clip type="1" x="0" y="0" width="768" height="1024" />
				<!-- ROI裁剪 -->

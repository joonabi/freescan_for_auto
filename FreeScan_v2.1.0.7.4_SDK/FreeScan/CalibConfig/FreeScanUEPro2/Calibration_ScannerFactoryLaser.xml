<?xml version="1.0" encoding="utf-8"?>
<calibration>
	<!-- 标定类型 -->
	<type>99</type>
	<!-- 是否存图 -->
	<saveCalibImages>1</saveCalibImages>
	<!-- 是否读图 -->
	<readImages>0</readImages>
	<!-- 存图路径 -->
	<savePath>./res/FreeScanUEPro2</savePath>
	<isCreateImgPath>false</isCreateImgPath>
	<!-- 位姿计算算法接口 每个设备及标定板不一样需要配置 -->
	<poseAlgMethod>trackMarkerWithDep</poseAlgMethod>
	<!-- 光平面标定计算 -->
	<laserAlgMthod>runLaserRebuildTy</laserAlgMthod>
	<!-- 降采样计算 -->
	<downSampleCalc>true</downSampleCalc>
	<!-- 数据保存 -->
	<saveCalibData>true</saveCalibData>
	<!-- 写设备区间 -->
	<writeAreas>2</writeAreas>
	<commands>
		<command0 type="init">
			<!-- 设备指令相关 -->
			<DevCommand>
				<!-- 开关流 -->
				<stream>true</stream>
				<!--<downSampling>false</downSampling> -->
				<!-- 触发周期 ms -->
				<triggerPeriod>20</triggerPeriod>
				<gainExp>
					<GE1 gain="200" exp="2000" />
					<GE2 gain="200" exp="2000" />
				</gainExp>
				<ExtractPointArea>1</ExtractPointArea>
				<ExtractPointSize>80</ExtractPointSize>
				<WorkMode>3</WorkMode>
				<led>0</led>
				<project></project>
				<!-- 激光配置 -->
				<laser>
					<!-- 激光线亮度 -->
					<LAS1 cross="true" grade="25" luminance="1980" type="1" />
					<LAS2 cross="false" grade="1" luminance="1000" type="1" />
					<LAS2 cross="false" grade="7" luminance="1000" type="1" />
					<!-- 激光线投射模式 -->
					<laserNum>0</laserNum>
				</laser>
				<turnTable>
				</turnTable>
			</DevCommand>
			<!-- 界面指令 -->
			<UICommand>
				<!-- 当前标定第几组 -->
				<setGroupIndex param="22" />
				<!-- 大圆中心偏移 -->
				<setOffset offset="0" />
				<!-- 标定板旋转 -->
				<rotation angle="0" />
			</UICommand>
			<!-- 算法指令 -->
			<AlgCommand>
			</AlgCommand>
		</command0>
		<command1 type="finish">
			<!-- 设备指令相关 -->
			<DevCommand>
				<!-- 开关流 -->
				<stream>false</stream>
				<laser>
					<laserNum>0</laserNum>
				</laser>
				<led>0</led>
			</DevCommand>
			<!-- 界面指令 -->
			<UICommand>
			</UICommand>
			<!-- 算法指令 -->
			<AlgCommand>
			</AlgCommand>
		</command1>
	</commands>
	<positionInfo>

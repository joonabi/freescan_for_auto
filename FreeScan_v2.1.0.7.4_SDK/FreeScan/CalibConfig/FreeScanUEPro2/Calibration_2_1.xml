<?xml version="1.0" encoding="utf-8"?>
<calibration>
	<!-- 标定类型 -->
	<type>2</type>
	<!-- 是否存图 -->
	<saveCalibImages>0</saveCalibImages>
	<!-- 是否读图 -->
	<readImages>0</readImages>
	<!-- 存图路径 -->
	<savePath>./res/FreeScanUEPro2</savePath>
	<isCreateImgPath>false</isCreateImgPath>
	<!-- 位姿计算算法接口 每个设备及标定板不一样需要配置 -->
	<poseAlgMethod>trackMarker</poseAlgMethod>
	<!-- 光平面标定计算 -->
	<laserAlgMthod>runLaserRebuildTy</laserAlgMthod>
	<!-- 降采样计算 -->
	<downSampleCalc>true</downSampleCalc>
	<!-- 切换标定模式-->
	<changeCalibType>99</changeCalibType> 
	<!-- 数据保存 -->
	<saveCalibData>true</saveCalibData>
	<!-- 写设备区间 -->
	<writeAreas>2</writeAreas>
	<commands>
		<command0 type="init">
			<!-- 设备指令相关 -->
			<DevCommand>
				<!-- 开关流 -->
				<stream>true</stream>
				<!--<downSampling>false</downSampling> -->
				<!-- 触发周期 ms -->
				<triggerPeriod>20</triggerPeriod>
				<gainExp>
					<GE1 gain="180" exp="1800" />
					<GE2 gain="180" exp="1800" />
				</gainExp>
				<ExtractPointArea>1</ExtractPointArea>
				<ExtractPointSize>80</ExtractPointSize>
				<WorkMode>3</WorkMode>
				<led>0</led>
				<project></project>
				<!-- 激光配置 -->
				<laser>
					<!-- 激光线亮度 -->
					<LAS1 cross="true" grade="25" luminance="1980" type="1" />
					<LAS2 cross="false" grade="1" luminance="1000" type="1" />
					<LAS2 cross="false" grade="7" luminance="1000" type="1" />
					<!-- 激光线投射模式 -->
					<laserNum>0</laserNum>
				</laser>
				<turnTable>
				</turnTable>
			</DevCommand>
			<!-- 界面指令 -->
			<UICommand>
				<!-- 当前标定第几组 -->
				<setGroupIndex param="20" />
				<!-- 大圆中心偏移 -->
				<setOffset offset="-175" />
				<!-- 标定板旋转 -->
				<rotation angle="0" />
			</UICommand>
			<!-- 算法指令 -->
			<AlgCommand>
			</AlgCommand>
		</command0>
		<command1 type="finish">
			<!-- 设备指令相关 -->
			<DevCommand>
				<!-- 开关流 -->
				<stream>false</stream>
				<laser>
					<laserNum>0</laserNum>
				</laser>
				<led>0</led>
			</DevCommand>
			<!-- 界面指令 -->
			<UICommand>
			</UICommand>
			<!-- 算法指令 -->
			<AlgCommand>
			</AlgCommand>
		</command1>
	</commands>
	<positionInfo>
		<!-- 设备旋转角度 -->
		<angle x="0" y="0" z="180" thresX="10" thresY="10" thresZ="10" />
		<!-- 设备中心投射到标定板位置 -->
		<pt x="0" y="0" z="0" thresDim="40" thresHeight="10" offsetX="0" offsetY="0" />
	</positionInfo>
	<!-- 图片类型/命名相关 -->
	<captureInfo>
		<cameras count="2">
			<camera0>
				<!-- 是否旋转 -->
				<!-- 
				<rotation transpose="0" flip="0" />
				-->
				<!-- 是否裁剪 -->
				<UEPro2clip type="1" x="0" y="0" width="768" height="1024" />
				<!-- ROI裁剪 -->
				<!-- 
				<clipInfo type="ROI">	
					<clipParam x="0" y="0" width="0" height="0"/>
				</clipInfo> 
				-->
				<!-- 格式转换信息 -->
				<formatInfo></formatInfo>
			</camera0>
			<camera1>
				<!-- 是否旋转 -->
				<!-- 
				<rotation transpose="0" flip="0" />
				-->
				<!-- 是否裁剪 -->
				<UEPro2clip type="1" x="0" y="0" width="768" height="1024" />
				<!-- ROI裁剪 -->
				<!-- 
				<clipInfo type="ROI" x="0" y="0" width="0" height="0" />
				-->
				<!-- 格式转换信息 -->
				<formatInfo></formatInfo>
			</camera1>
		</cameras>
	</captureInfo>
	<groups count="6">
		<!-- 平行线 -->
		<group0  name="" count="9" distanceMid="170" distanceMax="230">
			<commands>
				<command0 type="init">
					<!-- 设备指令相关 -->
					<DevCommand>
						<!-- 开补光灯 -->
						<led>800</led>
						<!-- 激光配置 -->
						<laser>
							<!-- 激光线投射模式 -->
							<laserNum>5</laserNum>
						</laser>
					</DevCommand>
					<!-- 界面指令 -->
					<UICommand>
						<!-- 当前标定第几组 -->
						<setGroupIndex param="20" />
						<setOffset offset="-175" />
					</UICommand>
				</command0>
				<command1 type="finish">
					<!-- 界面指令 -->
					<UICommand>
						<setOffset offset="0" />
					</UICommand>
				</command1>
			</commands>
			<positionInfo>
				<!-- 设备旋转角度 -->
				<angle />
				<!-- 设备中心投射到标定板位置 -->
				<pt offsetX="-160" offsetY="0" />
			</positionInfo>
			<!-- 图片类型/命名相关 -->
			<captureInfo>
				<frames count="1">
					<!-- type: 0相机 3左倾 4右倾 5平行线 -->
					<frame0 type="5" grade="5">
						<pictures>
							<!-- X_X_X_X_groupIndex_stepIndex -->
							<picture0 name="Left_LaserFive_Parallel_%1_%2" />
							<picture1 name="Right_LaserFive_Parallel_%1_%2" />
							<picture2 name="Left_LaserFiveImage_Parallel_%1_%2" />
							<picture3 name="Right_LaserFiveImage_Parallel_%1_%2" />
						</pictures>
					</frame0>
				</frames>
			</captureInfo>
			<steps>
				<step0 valid="true">
					 
				</step0>
				<step1 valid="true">
					 
				</step1>
				<step2 valid="true">
					 
				</step2>
				<step3 valid="true">
					 
				</step3>
				<step4 valid="true">
					 
				</step4>
				<step5 valid="true">
					 
				</step5>
				<step6 valid="true">
					 
				</step6>
				<step7 valid="true">
					 
				</step7>
				<step8 valid="true">
					 
				</step8>
			</steps>
		</group0>	
		<!-- 垂直相机 交叉13线 单线 -->
		<group1 name="" count="9" distanceMid="240" distanceMax="500">
			<commands>
				<command0 type="init">
					<!-- 设备指令相关 -->
					<DevCommand>
						<!-- 开补光灯 -->
						<led>800</led>
						<!-- 激光配置 -->
						<laser>
							<!-- 激光线投射模式 -->
							<laserNum>131</laserNum>
						</laser>
					</DevCommand>
					<!-- 界面指令 -->
					<UICommand>
						<!-- 当前标定第几组 -->
						<setGroupIndex param="21" />
						<!-- 大圆中心偏移 -->
						<setOffset offset="0" />
					</UICommand>
				</command0>
			</commands>
			<!-- 图片类型/命名相关 -->
			<captureInfo>
				<frames count="4">
					<frame0 type="3" grade="13">
						<pictures>
							<!-- X_X_X_X_groupIndex_stepIndex -->
							<picture0 name="Left_Laser13_Cross_UpSide_%1_%2" />
							<picture1 name="Right_Laser13_Cross_UpSide_%1_%2" />
							<picture2 name="Left_Laser13Image_Cross_UpSide_%1_%2" />
							<picture3 name="Right_Laser13Image_Cross_UpSide_%1_%2" />
						</pictures>
					</frame0>
					<frame1 type="4" grade="13">
						<pictures>
							<picture0 name="Left_Laser13_Cross_DownSide_%1_%2" />
							<picture1 name="Right_Laser13_Cross_DownSide_%1_%2" />
							<picture2 name="Left_Laser13Image_Cross_DownSide_%1_%2" />
							<picture3 name="Right_Laser13Image_Cross_DownSide_%1_%2" />
						</pictures>
					</frame1>
					<frame2 type="7" grade="1">
						<pictures>
							<picture0 name="Left_LaserSingle_Parallel_%1_%2" />
							<picture1 name="Right_LaserSingle_Parallel_%1_%2" />
							<picture2 name="Left_LaserSingleImage_Parallel_%1_%2" />
							<picture3 name="Right_LaserSingleImage_Parallel_%1_%2" />	
						</pictures>
					</frame2>
				</frames>
			</captureInfo>
			<!-- UEP 13线 -->
			<steps>
				<step0 valid="true">
					 
				</step0>
				<step1 valid="true">
					 
				</step1>
				<step2 valid="true">
					 
				</step2>
				<step3 valid="true">
					 
				</step3>
				<step4 valid="true">
					 
				</step4>
				<step5 valid="true">
					 
				</step5>
				<step6 valid="true">
					 
				</step6>
				<step7 valid="true">
					 
				</step7>
				<step8 valid="true">
					 
				</step8>
			</steps>
		</group1>
	</groups>
</calibration>
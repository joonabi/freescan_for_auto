        <file>qml/components/Checkbox.qml</file>

        <!-- 페이지 -->
        <file>qml/pages/WorkplaceManagement.qml</file>
        <file>qml/pages/PreparationStep.qml</file>
        <file>qml/pages/ScanStartStep.qml</file>
        <file>qml/pages/SettingsStep.qml</file>
        <file>qml/pages/LogViewer.qml</file>
        <file>qml/pages/ManualStep.qml</file>
    </qresource>

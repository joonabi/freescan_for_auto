# ─────────────────────────────────────────────
# C++ / CMake 빌드 결과물
# ─────────────────────────────────────────────
build/
out/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/

# 컴파일 결과물
*.exe
*.dll
*.lib
*.a
*.pdb
*.ilk
*.obj
*.o
*.exp

# ─────────────────────────────────────────────
# Qt 자동 생성 파일
# ─────────────────────────────────────────────
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.qm
*.pro.user
*.pro.user.*

# ─────────────────────────────────────────────
# Visual Studio / IDE
# ─────────────────────────────────────────────
.vs/
*.user
*.suo
*.ncb
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.vcxproj.user
*.sln          # VS가 자동 생성하는 것만 제외 (필요 시 제거)

# ─────────────────────────────────────────────
# SDK 바이너리 (소스코드만 관리, DLL/LIB 제외)
# ─────────────────────────────────────────────
# SDK DLL/LIB는 별도 배포 — 저장소에 포함하지 않음
# *.dll, *.lib 는 위에서 이미 제외됨

# ─────────────────────────────────────────────
# 로그 / 임시 파일
# ─────────────────────────────────────────────
log_sdk/
*.log
*.tmp
*.bak
*.orig
Thumbs.db
.DS_Store

# ─────────────────────────────────────────────
# 스캔 결과물 (대용량 3D 데이터)
# ─────────────────────────────────────────────
*.stl
*.obj
*.ply
*.ptx
*.sln_*

# ─────────────────────────────────────────────
# 포함할 파일 (명시적 예외)
# ─────────────────────────────────────────────
# presets.json — 기본 프리셋 설정은 포함
!presets.json

# .qrc 리소스 파일은 포함
!*.qrc

# CMakeLists.txt는 포함
!CMakeLists.txt
